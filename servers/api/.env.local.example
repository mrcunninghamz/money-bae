# Copy to .env.local and point at whatever Postgres you're using locally
# (a local install, or the shared Azure dev database — your choice), then
# run ./use-local-env.sh to activate it.
DATABASE_URL=postgres://admin:root@localhost:5433/money_bae_api?sslmode=disable
PORT=8080

# Entra External ID (CIAM) — see platform/entra-external-id/. Issuer's
# tenant segment is the tenant ID, not its name (kkbaeexternalid) — CIAM's
# issuer only matches when queried this way. Audience is money-bae-api-local's
# client ID (confirmed from a real token's aud claim, not its Application ID
# URI — CIAM issues access tokens audienced to the raw client ID).
OIDC_ISSUER_URL=https://6da7bb61-fb8f-4d95-aa49-7808c0b05d51.ciamlogin.com/6da7bb61-fb8f-4d95-aa49-7808c0b05d51/v2.0
OIDC_AUDIENCE=7fd6aa77-cfbc-4048-ac21-c756ebd1f701
