# Copy to .env.dev to point at the shared Azure dev database, then run
# ./use-dev-env.sh to activate it.
DATABASE_URL=postgres://username:password@psql-kkb-core-cus-dev.postgres.database.azure.com/money_bae_api?sslmode=require
PORT=8080

# Entra External ID (CIAM) — see platform/entra-external-id/. Same tenant
# as local; audience is money-bae-api-dev's client ID instead.
OIDC_ISSUER_URL=https://6da7bb61-fb8f-4d95-aa49-7808c0b05d51.ciamlogin.com/6da7bb61-fb8f-4d95-aa49-7808c0b05d51/v2.0
OIDC_AUDIENCE=b035f6c4-d91c-489b-88bd-4342e60463cd

# Only read by cmd/import-legacy-data: overrides the seeded user's sub
# to match your real dev tenant login (the `sub` claim from a decoded
# access token), so the API resolves you to the imported legacy data
# instead of provisioning a second, empty user.
SEED_USER_SUB=
