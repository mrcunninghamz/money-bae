{
	"info": {
		"name": "money-bae API",
		"description": "Requests against the Go API in servers/api. Update this collection as routes are added.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "oauth2",
		"oauth2": [
			{ "key": "grant_type", "value": "authorization_code_with_pkce", "type": "string" },
			{ "key": "authUrl", "value": "{{authUrl}}", "type": "string" },
			{ "key": "accessTokenUrl", "value": "{{tokenUrl}}", "type": "string" },
			{ "key": "clientId", "value": "{{clientId}}", "type": "string" },
			{ "key": "scope", "value": "{{scope}}", "type": "string" },
			{ "key": "redirect_uri", "value": "https://oauth.pstmn.io/v1/browser-callback", "type": "string" },
			{ "key": "useBrowser", "value": true, "type": "boolean" },
			{ "key": "client_authentication", "value": "header", "type": "string" },
			{ "key": "challengeAlgorithm", "value": "S256", "type": "string" },
			{ "key": "addTokenTo", "value": "header", "type": "string" },
			{ "key": "tokenName", "value": "money-bae-token", "type": "string" }
		]
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080"
		},
		{
			"key": "token",
			"value": "mock-token",
			"description": "Manually-pasted fallback bearer token. Prefer the collection's OAuth 2.0 auth (Get New Access Token in Postman) once a real IdP is wired in — see platform/entra-external-id/CLAUDE.md."
		},
		{
			"key": "incomeId",
			"value": "",
			"description": "Auto-populated by Income > Create's test script; used by Get/Update/Delete."
		}
	],
	"item": [
		{
			"name": "Health Check",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/health",
					"host": ["{{baseUrl}}"],
					"path": ["health"]
				}
			}
		},
		{
			"name": "Me",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/me",
					"host": ["{{baseUrl}}"],
					"path": ["me"]
				}
			}
		},
		{
			"name": "Income",
			"item": [
				{
					"name": "Create",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    pm.collectionVariables.set('incomeId', pm.response.json().id);",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"date\": \"2026-01-15T00:00:00Z\",\n  \"amount\": { \"amount\": 150000, \"currency\": \"USD\" },\n  \"ledgerId\": null,\n  \"notes\": \"created from Postman\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/incomes",
							"host": ["{{baseUrl}}"],
							"path": ["incomes"]
						}
					}
				},
				{
					"name": "List",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/incomes",
							"host": ["{{baseUrl}}"],
							"path": ["incomes"]
						}
					}
				},
				{
					"name": "Get",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/incomes/{{incomeId}}",
							"host": ["{{baseUrl}}"],
							"path": ["incomes", "{{incomeId}}"]
						}
					}
				},
				{
					"name": "Update",
					"request": {
						"method": "PUT",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"date\": \"2026-02-01T00:00:00Z\",\n  \"amount\": { \"amount\": 99900, \"currency\": \"USD\" },\n  \"ledgerId\": null,\n  \"notes\": \"updated from Postman\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/incomes/{{incomeId}}",
							"host": ["{{baseUrl}}"],
							"path": ["incomes", "{{incomeId}}"]
						}
					}
				},
				{
					"name": "Delete",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/incomes/{{incomeId}}",
							"host": ["{{baseUrl}}"],
							"path": ["incomes", "{{incomeId}}"]
						}
					}
				}
			]
		}
	]
}